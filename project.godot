; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dino Island: Idle Tycoon"
run/main_scene="res://scenes/main/Splash.tscn"
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(0.92, 0.8, 0.55, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="res://resources/audio/bus_layout.tres"

[autoload]

LocaleManager="*res://autoload/LocaleManager.gd"
SpeciesDatabase="*res://autoload/SpeciesDatabase.gd"
GameManager="*res://autoload/GameManager.gd"
PrestigeManager="*res://autoload/PrestigeManager.gd"
AchievementManager="*res://autoload/AchievementManager.gd"
SaveManager="*res://autoload/SaveManager.gd"
AdsManager="*res://autoload/AdsManager.tscn"
AudioManager="*res://autoload/AudioManager.gd"
EffectsManager="*res://autoload/EffectsManager.gd"

[display]

window/size/viewport_width=450
window/size/viewport_height=706
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/AdmobPlugin/plugin.cfg", "res://addons/godot_mcp/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://translations.pt.translation", "res://translations.en.translation", "res://translations.es.translation", "res://translations.de.translation", "res://translations.fr.translation")
locale/fallback="pt"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.11, 0.08, 0.05, 1)
